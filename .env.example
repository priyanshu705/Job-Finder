# ─── Google Sheets ───────────────────────────────
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ─── Alerting ────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
ALERT_EMAIL=yourgmail@gmail.com
ALERT_EMAIL_PASSWORD=your_gmail_app_password
ALERT_RECEIVER=yourgmail@gmail.com

# ─── Platform Credentials ────────────────────────
INTERNSHALA_EMAIL=you@email.com
INTERNSHALA_PASSWORD=yourpassword

# ─── User Profile ────────────────────────────────
RESUME_PATH=./resumes/resume.pdf
SEARCH_QUERY=python developer
USER_NAME=Your Full Name
USER_PHONE=9876543210
USER_LINKEDIN=https://linkedin.com/in/yourprofile
USER_YEARS_EXP=2
EXPECTED_SALARY=5 LPA
NOTICE_PERIOD=Immediate

# ─── Database / Queue ────────────────────────────
# Local fallback:
# DATABASE_URL=sqlite:///finder.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finder
REDIS_URL=redis://localhost:6379/0

# ─── Local API ────────────────────────────────────
# Safe defaults keep the API on your own machine. Change deliberately if needed.
API_HOST=127.0.0.1
API_PORT=5000
FLASK_DEBUG=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Playwright ─────────────────────────────────
# Use Playwright's hermetic browser install path in production.
PLAYWRIGHT_BROWSERS_PATH=0
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=false

# ─── Runtime ──────────────────────────────────────
PYTHONPATH=src
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=120
CELERYD_CONCURRENCY=1
CELERY_VISIBILITY_TIMEOUT=3600
CELERY_SOCKET_TIMEOUT=30
CELERY_SOCKET_CONNECT_TIMEOUT=10
CELERY_MAX_TASKS_PER_CHILD=100
CELERY_MAX_MEMORY_PER_CHILD_KB=512000
WORKER_MEMORY_PANIC_MB=900
STALE_TASK_MINUTES=30
